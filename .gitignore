# Research materials and working context are not part of the implementation tree.
/research/
/vole-audio-prompt.txt

# Rust build artifacts
/target/
**/*.rs.bk
/.scratch/

# GPU build artifacts produced by scripts/build-*.sh
/scripts/out/
target/device/
*.ptx
*.cubin
*.hsaco
*.gpu

# Receipts are immutable evidence outputs; the raw data is versioned below but
# bulk generated artifacts should not be committed.
/receipts/traces/
/receipts/artifacts/

# ALSA / endpoint scratch
*.core
core

# Bulk real-corpus audio (LibriSpeech subset). The manifest of identities and
# canonical i32 hashes IS committed (corpus/real_manifest.json); the audio bulk
# is not, because it is externally sourced (CC BY 4.0, OpenSLR SLR12).
/corpus/real/
